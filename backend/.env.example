# =============================================================================
# FastAPI backend — copy to `backend/.env` and/or repo root `.env` (both load).
# =============================================================================

# --- Required: deployment environment (controls which Postgres URL wins) ---
# production → use DATABASE_POOLER_URL when set, else DATABASE_URL
# development → use DATABASE_DIRECT_URL when set, else DATABASE_URL
ENVIRONMENT=development

# --- Required: PostgreSQL (validated at startup; must start with postgresql:// or postgres://) ---
# Direct (dev / migrations): Project Settings → Database → URI (host db.<ref>.supabase.co, port 5432)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Optional: explicit URLs so you can keep one ENVIRONMENT and switch hosts without editing DATABASE_URL
# Transaction pooler (production throughput): port 6543, host aws-0-REGION.pooler.supabase.com
# DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Direct session (local/dev): same as DATABASE_URL above if you use overrides
# DATABASE_DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- Optional: Supabase REST (only needed if you call Supabase HTTP APIs from the backend) ---
# If unset, Postgres still uses DATABASE_URL. You can reuse the Next.js keys:
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are also read.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_role_key

# --- App ---
DATA_DIR=../data
TITLE21_SOURCE=auto
TITLE21_TABLE=title_21_sections
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_ROUTER_API_KEY=
OPENAI_ROUTER_MODEL=
OPENAI_COMPAT_BASE_URL=
