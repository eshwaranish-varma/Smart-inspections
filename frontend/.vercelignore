# Vercel Build Ignore File

# Source files not needed for build
/src/**/*.test.ts
/src/**/*.test.tsx
/src/**/*.spec.ts
/src/**/*.spec.tsx

# Development files
node_modules/
.env.local
.env.development
.env.test
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore

# Testing
coverage/
.coverage

# Build artifacts
vitest.config.ts
playwright.config.ts

# Documentation
/docs
*.md

# Backend & Data
/backend
/data
/artifacts
/notebooks
/scripts
/src (root level, not src/ in frontend)
/docker
/tests
/supabase
/config

# Docker
docker-compose*.yml
Dockerfile*

# Root config (except needed ones)
setup.py
README.md
LICENSE
render.yaml
requirements*.txt

# Project files we don't need
.dockerignore
.gitattributes
