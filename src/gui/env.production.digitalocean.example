# Copy values into DigitalOcean App Platform "Environment" for the web service, or
# merge with your .env.production for Docker/VPS. Do not commit real secrets.
#
# Your current FastAPI base (no trailing slash, no /api):
NEXT_PUBLIC_API_URL=https://smartinspection-production-i8ete.ondigitalocean.app
BACKEND_API_URL=https://smartinspection-production-i8ete.ondigitalocean.app
#
# After the frontend is deployed, set this to that app’s public HTTPS root (no trailing slash):
NEXT_PUBLIC_APP_URL=https://YOUR_FRONTEND_SUBDOMAIN.ondigitalocean.app
#
# Server-side: same Postgres and JWT as local production (from Supabase / secrets)
# DATABASE_URL=postgresql://...
# JWT_SECRET=...
#
# Supabase (browser + middleware) — use https:// not http://
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#
# Backend CORS: add NEXT_PUBLIC_APP_URL to FastAPI CORS_ORIGINS, e.g.
# CORS_ORIGINS=https://YOUR_FRONTEND_SUBDOMAIN.ondigitalocean.app,https://smartinspection-production-i8ete.ondigitalocean.app
#
# Optional: email OTP
# SMTP_HOST=
# SMTP_PORT=587
# ...
#
# GitHub Actions health-check workflow (optional repository secrets)
# FRONTEND_PRODUCTION_URL  — live Next.js https URL (for scheduled curl checks)
# PRODUCTION_API_BASE     — live FastAPI https origin, no /api (default in workflow is the DO API URL)
# RENDER_API_HEALTH_URL   — full URL to /api/health (only if you use .github/workflows/deploy-backend.yml for Render)
