# =============================================================================
# Production / VPS (Docker Compose) — copy to `.env.production` and fill in.
# Do not commit `.env.production` (gitignored).
#
# Run: docker compose --env-file .env.production up --build -d
# =============================================================================

# --- PostgreSQL (Supabase: Project Settings → Database → URI, use sslmode=require)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Optional Supabase pooler (serverless-friendly):
# DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# --- Supabase (optional: REST client / storage; also used by backend if set)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key

# --- JWT (Next.js sessions) — long random string
JWT_SECRET=change_me_to_a_long_random_string

# --- Public site URL (no trailing slash; used in links / cookies / Next build)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Browser → FastAPI when not same-origin (often empty if nginx serves both on one host)
# NEXT_PUBLIC_API_URL=

# --- Supabase browser client (optional; middleware session refresh)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- LLM
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- CORS: comma-separated origins allowed to call FastAPI (include https://your-domain.com)
CORS_ORIGINS=https://your-domain.com,http://localhost:3000
#
# --- Split stack (e.g. FastAPI on DigitalOcean App A, Next.js on App B)
# If the API is at https://smartinspection-production-XXXX.ondigitalocean.app and the GUI is elsewhere:
# 1) On the Next app / build, set (no trailing slash; code appends /api):
#    NEXT_PUBLIC_API_URL=https://smartinspection-production-XXXX.ondigitalocean.app
#    NEXT_PUBLIC_APP_URL=https://<your-frontend>.ondigitalocean.app
#    BACKEND_API_URL same host as NEXT_PUBLIC_API_URL
# 2) On FastAPI, add the frontend https origin to CORS_ORIGINS
# 3) See src/gui/infra/digitalocean-app-frontend.example.yaml and src/gui/env.production.digitalocean.example

# --- Email OTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# --- Ports (optional overrides)
# NGINX_PORT=80
# GUI_PORT=3000
# BACKEND_PORT=8000
