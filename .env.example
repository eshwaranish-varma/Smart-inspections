# =============================================================================
# Smart Inspections — production / Docker (copy to `.env` in this repo root)
# =============================================================================
#
# Supabase (recommended): Project Settings → Database → URI (Session or Direct).
# Always use SSL: append `?sslmode=require` if the URI does not include it.
#
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or direct (recommended for Next.js + DDL): db host port 5432
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
# Optional: if you keep transaction pooler (6543) for DATABASE_URL, set this for reliable schema setup:
# DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
DATABASE_URL=postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Same secret for all app instances; use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# Public URL of the Next.js app (used in links / cookies). Use https://yourdomain.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated browser origins allowed to call FastAPI (include your real site and nginx URL).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://127.0.0.1,https://yourdomain.com

# Next.js server → FastAPI inside Docker (do not use localhost here; use the compose service name).
BACKEND_API_URL=http://backend:8000

# LLM (set keys for your provider; see backend/app/config.py)
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Vite `frontend` image: API base baked at build time. Behind nginx use your public API root, e.g.:
# VITE_API_URL=https://yourdomain.com/api
VITE_API_URL=http://localhost:8000/api

# Docker Compose ports (optional overrides)
# NGINX_PORT=80
# GUI_PORT=3000
# BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Local PostgreSQL in Docker (optional). Use only if you are NOT using Supabase.
# Start with: docker compose --profile local-db up --build
# Then set DATABASE_URL=postgresql://postgres:postgres@db:5432/smart_inspections
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=smart_inspections
# -----------------------------------------------------------------------------

# Email (optional — signup OTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
